# ══════════════════════════════════════════════════════════
# .gitignore — Archivos que Git debe IGNORAR (nunca se suben)
# OJO: los comentarios deben ir en su PROPIA línea.
# Un comentario al final de una línea invalida el patrón.
# ══════════════════════════════════════════════════════════

# Dependencias: se instalan con "npm install", pesan +100 MB
node_modules/

# Carpeta de producción: se regenera con "npm run build"
dist/

# Caché local de Wrangler (se regenera solo al desplegar)
.wrangler/

# Archivos temporales de herramientas del agente
.temp/

# Registros y archivos temporales
*.log

# Archivos basura de Windows / Mac
Thumbs.db
.DS_Store

# Herramientas locales del proyecto (ffmpeg portable, ~115 MB; no va al repo)
.herramientas/

# Videos fuente SIN comprimir (pesan decenas de MB)
# Al repo solo suben los comprimidos que están en public/video/
assets/video/*-original.mp4

# Documentos internos/confidenciales (estudio comercial: costos y márgenes)
assets/documentos/
